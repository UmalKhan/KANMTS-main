# ─────────────────────────────────────────────────────────────────────────────
#  STEP 1 — OHLCV from Yahoo Finance  (FIXED: uses Ticker.history() first)
# ─────────────────────────────────────────────────────────────────────────────
def fetch_ohlcv(ticker, start, end):
    print(f"\n[1/6] Downloading OHLCV for {ticker} via yfinance ...")
    try:
        import yfinance as yf
    except ImportError:
        sys.exit("Run:  pip install yfinance")

    raw = None

    # ── Strategy 1: yf.Ticker().history() ────────────────────────────────────
    # More reliable than yf.download() for index tickers on newer yfinance versions
    for t in [ticker, "SPY", "^GSPC", "QQQ"]:
        try:
            print(f"    → Trying Ticker('{t}').history() ...")
            obj = yf.Ticker(t)
            r = obj.history(start=start, end=end, auto_adjust=True)
            if isinstance(r.columns, pd.MultiIndex):
                r.columns = r.columns.get_level_values(0)
            if len(r) > 10:
                raw = r
                print(f"    ✓ Got {len(raw)} rows using Ticker('{t}')")
                break
        except Exception as e:
            print(f"    ✗ Failed: {e}")

    # ── Strategy 2: yf.download() with period="max" as last resort ───────────
    if raw is None:
        for t in ["SPY", "QQQ", "^DJI"]:
            try:
                print(f"    → Trying yf.download('{t}', period='max') ...")
                r = yf.download(t, period="max", progress=False, auto_adjust=True)
                if isinstance(r.columns, pd.MultiIndex):
                    r.columns = r.columns.get_level_values(0)
                r = r[r.index >= pd.Timestamp(start)]
                if len(r) > 10:
                    raw = r
                    print(f"    ✓ Got {len(raw)} rows using download('{t}')")
                    break
            except Exception as e:
                print(f"    ✗ Failed: {e}")

    if raw is None or len(raw) == 0:
        sys.exit(
            "\n✗ Could not download any price data.\n"
            "  Try:  pip install --upgrade yfinance\n"
            "  Also check your internet connection."
        )

    raw.index = pd.to_datetime(raw.index)

    # Strip timezone info if present (newer yfinance adds UTC)
    if raw.index.tz is not None:
        raw.index = raw.index.tz_localize(None)
    raw.index.name = "Date"

    # Map column names — handle both adjusted and non-adjusted column sets
    col_map = {}
    for c in raw.columns:
        cl = str(c).lower().strip()
        if cl == "open":
            col_map[c] = "Open_Price"
        elif cl in ("close", "adj close", "adjclose"):
            col_map[c] = "Close_Price"
        elif cl == "high":
            col_map[c] = "High_Price"
        elif cl == "low":
            col_map[c] = "Low_Price"
        elif cl == "volume":
            col_map[c] = "Volume"
    raw = raw.rename(columns=col_map)

    needed = ["Open_Price", "Close_Price", "High_Price", "Low_Price", "Volume"]
    missing = [c for c in needed if c not in raw.columns]
    if missing:
        sys.exit(
            f"✗ Missing columns after rename: {missing}.\n"
            f"  Raw columns were: {list(raw.columns)}"
        )

    df = raw[needed].copy()

    if len(df) == 0:
        sys.exit("✗ DataFrame is empty after processing. Check your date range.")

    df["Daily_Return_Pct"] = df["Close_Price"].pct_change() * 100
    df["Volatility_Range"] = df["High_Price"] - df["Low_Price"]

    print(f"    ✓ {len(df)} trading days  ({df.index[0].date()} → {df.index[-1].date()})")
    return df


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 2 — VIX from Yahoo Finance  (FIXED: uses Ticker.history() first)
# ─────────────────────────────────────────────────────────────────────────────
def fetch_vix(start, end):
    print("[2/6] Downloading VIX (^VIX) ...")
    try:
        import yfinance as yf
    except ImportError:
        sys.exit("Run:  pip install yfinance")

    raw = None

    # Try Ticker().history() first
    for t in ["^VIX", "VIXY"]:
        try:
            print(f"    → Trying Ticker('{t}').history() ...")
            obj = yf.Ticker(t)
            r = obj.history(start=start, end=end, auto_adjust=True)
            if isinstance(r.columns, pd.MultiIndex):
                r.columns = r.columns.get_level_values(0)
            if len(r) > 10:
                raw = r
                print(f"    ✓ Got {len(raw)} rows")
                break
        except Exception as e:
            print(f"    ✗ Failed: {e}")

    # Fallback to yf.download
    if raw is None:
        try:
            raw = yf.download("^VIX", start=start, end=end, progress=False, auto_adjust=True)
            if isinstance(raw.columns, pd.MultiIndex):
                raw.columns = raw.columns.get_level_values(0)
        except Exception as e:
            print(f"    ✗ yf.download also failed: {e}")

    if raw is None or len(raw) == 0:
        print("    ⚠  VIX unavailable — filling with 20.0 placeholder.")
        idx = pd.date_range(start, end, freq="D")
        return pd.DataFrame({"VIX_Close": 20.0}, index=idx)

    raw.index = pd.to_datetime(raw.index)
    if raw.index.tz is not None:
        raw.index = raw.index.tz_localize(None)

    vix = raw[["Close"]].rename(columns={"Close": "VIX_Close"})
    print(f"    ✓ {len(vix)} rows")
    return vix


