if __name__ == "__main__":
    print("="*60)
    print("  KAN-MTS Financial Dataset Builder")
    print(f"  Ticker: {TICKER}  |  {START_DATE} → {END_DATE}")
    print("="*60)

    # Fetch
    ohlcv = fetch_ohlcv(TICKER, START_DATE, END_DATE)
    vix   = fetch_vix(START_DATE, END_DATE)
    dxy   = fetch_dxy(START_DATE, END_DATE)
    fed   = fetch_fed_rate(START_DATE, END_DATE)
    gpr   = fetch_gpr()

    # Merge
    df = merge_all(ohlcv, vix, dxy, fed, gpr)

    # ✅ NOW build features (this creates missing columns)
    df = build_news_sentiment(df)

    # ✅ NOW reorder columns (FIXED POSITION)
    col_order = [
        "Open_Price", "Close_Price", "High_Price", "Low_Price", "Volume",
        "Daily_Return_Pct", "Volatility_Range", "VIX_Close",
        "Economic_News_Flag", "Sentiment_Score",
        "Federal_Rate_Change_Flag", "GeoPolitical_Risk_Score", "Currency_Index"
    ]

    df = df[col_order]

    # Save CSV
    df.to_csv(OUTPUT_CSV)
    print(f"\n[Output] CSV saved → {OUTPUT_CSV}")

    # Summary
    print_summary(df)

    # Export tensors
    export_pytorch_tensors(df, SEQ_LEN, LABEL_LEN, PRED_LEN, OUTPUT_PT)

    print(f"\n[Done] Files created:")
    print(f"  {OUTPUT_CSV}")
    print(f"  {OUTPUT_PT}")
